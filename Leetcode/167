class Solution {
public:
    vector<int> twoSum(vector<int>& numbers, int target) {
        int n=numbers.size();
        int st=0;
        int end=n-1;
        //vector<int>ans(2);
        while(st<end){
            int cs=numbers[st]+numbers[end];
            if(cs==target){
                return {st+1,end+1};
            }else if(cs>target){
                end--;
            }else{
                st++;
            }
        }
        return {};
    }
};