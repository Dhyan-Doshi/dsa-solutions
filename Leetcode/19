/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* removeNthFromEnd(ListNode* head, int n) {
        ListNode*curr=head;
        ListNode*temp;
        int length=0;
        while(curr!=NULL){
            length++;
            curr=curr->next;
        }
         curr=head;
        if(length==n){
            temp=head;
            head=head->next;
            delete temp;
            return head;
        }
        curr=head;
        int remove=length-n;
        for(int i=1;i<remove;i++){
            curr=curr->next;
        }
        temp=curr->next;
        curr->next=temp->next;
        delete temp;
        return head;
    }
};