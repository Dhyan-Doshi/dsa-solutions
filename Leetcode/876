/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        int count=0;
        ListNode*curr=head;
        while(curr!=NULL){
            count++;
            curr=curr->next;
        }
        int ans;
        if(count%2!=0){
            int a=(count/2);
            for(int i=0;i<a;i++){
                head=head->next;
            }
            return head;
        }else{
            int b=count/2;
            for(int i=0;i<b;i++){
                head=head->next;
            }
            return head;
        }
        return 0;
    }
};