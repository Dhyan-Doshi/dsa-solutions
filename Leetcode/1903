class Solution {
public:
    string largestOddNumber(string num) {
        int n=num.length();
        if((num[n-1]-'0')%2!=0){
            return num;
        }
        //Piche se start kia coz agar last digit hee even ho gaya fir vo num is always even so
        for(int i=n-1;i>=0;i--){
            if((num[i]-'0')%2!=0){
                return num.substr(0,i+1);
            }
        }
        return "";
    }
};