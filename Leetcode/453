class Solution {
public:
    int minMoves(vector<int>& nums) {
        int n=nums.size();
        int moves=0;
        int min=INT_MAX;
        for(int i=0;i<n;i++){
            if(nums[i]<min){
                min=nums[i];
            }
        }
        for(int i = 0; i < n; i++) {
            moves=moves+nums[i]-min;
        }
        return moves;
    }
};