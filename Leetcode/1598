class Solution {
public:
    int minOperations(vector<string>& logs) {
        int n=logs.size();
        int cnt=0;
        for(int i=0;i<n;i++){
            if(logs[i]=="../"){
                cnt=max(0,cnt-1);
            }
            else if(logs[i]=="./"){
                continue;
            }
            else{
                cnt++;
            }
        }
        // if((cnt-1)>=0){
        //     return (cnt-1);
        // }else{
        //     return 0;
        // }
        return cnt;
    }
};