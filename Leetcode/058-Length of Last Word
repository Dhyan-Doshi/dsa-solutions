class Solution {
public:
    int lengthOfLastWord(string s) {
        int count=0;
        reverse(s.begin(),s.end());
        for(int i=0;i<s.length();i++){
            if(s[i]!=' '){
                count++;
            }else if(s[i]==' ' && count>0){
                break;
            }
        }
        return count;
    }
};