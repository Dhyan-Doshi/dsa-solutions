/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    int getDecimalValue(ListNode* head) {
       int s;
       int count=0;
       ListNode*curr=head;
       while(curr!=NULL){
        count++;
        curr=curr->next;
       }
       int ans=0;
       curr=head;
       while(curr!=NULL){
        ans+=(curr->val)*pow(2,count-1);
        count--;
        curr=curr->next;
       }
       return ans;
    }
};