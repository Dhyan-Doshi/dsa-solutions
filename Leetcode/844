class Solution {
public:
    bool backspaceCompare(string s, string t) {
        for(int i=0;i<s.length();i++){
            if(s[i]=='#'){
                if(i>0){
                s.erase(i-1,2);
                }else{
                s.erase(i,1);
            }
            i=-1;
        }
    }
        for(int i=0;i<t.length();i++){
            if(t[i]=='#'){
                if(i>0){
                t.erase((i-1),2);
                }else{
                    t.erase(i,1);
                }
                i=-1;
            }
        }
        int a=0;
        int b=0;
        while(a<s.length() || b<t.length()){
            if(s[a]==t[b]){
                a++;
                b++;
            }else if(s[a]!=t[b]){
                return false;
                break;
            }
        }
        return true;
    }
};