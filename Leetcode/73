class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
        int r=matrix.size();
        int c=matrix[0].size();
        vector<int> roww(r);
        vector<int> coll(c);
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                if(matrix[i][j]==0){
                    roww[i]=1;
                    coll[j]=1;
                }
            }
        }
        for(int i=0;i<r;i++){
            for(int j=0;j<c;j++){
                if(roww[i]==1 || coll[j]==1){
                    matrix[i][j]=0;
                }
            }
        }
    }
};