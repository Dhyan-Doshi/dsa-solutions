class Solution {
public:
    bool isPowerOfTwo(int n) {
        if(n==0){
            return false;
        }if(n==1){
            return true;
        }
        for(int i=0;i<31;i++){
            if(pow(2,i)==n){//ye 2 raise to i kr deta hai.
                return true;
                break;
            }
        }
        return false;
    }
};