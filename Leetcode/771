class Solution {
public:
    int numJewelsInStones(string jewels, string stones) {
        int pt1=0;
        int pt2=0;
        int cnt=0;
        while(pt2<stones.length()){
            for(int i=0;i<jewels.length();i++){
                if(stones[pt2]==jewels[i]){
                    cnt++;
                }
            }
            pt2++;
        }
        return cnt;
    }
};