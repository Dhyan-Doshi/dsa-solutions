class Solution {
public:
    bool isAdjacentDiffAtMostTwo(string s) {
        int n=s.length();
        int count=1;
        for(int i=0;i<n-1;i++){
            if(abs(s[i]-s[i+1])>2){
                count--;
            }
        }
        if(count<1){
            return false;
        }
        return true;
    }
};
