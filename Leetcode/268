class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n=nums.size();
        int mnum;
        sort(nums.begin(),nums.end());
        for(int i=0;i<n;i++){
            if(nums[i]!=i){
                mnum=i;
                return mnum;
            }
            else if(nums[n-1]!=i+1){
                mnum=i+1;
            }
        }
        return mnum;
    }
};