class Solution {
public:
    int secondHighest(string s) {
        int n=s.length();
        vector<int> arr;
        int j=0;
        for(int i=0;i<n;i++){
            if(isdigit(s[i])==true){
                arr.push_back(s[i]-'0');//Push back se element ate rhege as agar inititalization me n size define ki toh baki ke elements 0 ho jayege jo ek prolematic chiz ho jayegi..aldo"-'0'" is very important as vrna error!!!!!
                j++;
            }
        }
        int max=-1;
        int max2=-1;
        for(int i=0;i<arr.size();i++){
            if(arr[i]>max){
                max=arr[i];
            }
        }
        for(int i=0;i<arr.size();i++){
            if(arr[i]>max2 && arr[i]<max){
                max2=arr[i];
            }
        }
        return max2;
    }
};