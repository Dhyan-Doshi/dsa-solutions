class Solution {
public:
    int minMoves(vector<int>& nums) {
        int max=INT_MIN;
        int n=nums.size();
        for(int i=0;i<n;i++){
            if(nums[i]>max){
                max=nums[i];
            }
        }
        int moves=0;
        for(int i=0;i<n;i++){
            moves+=max-nums[i];
        }
        return moves;
    }
};