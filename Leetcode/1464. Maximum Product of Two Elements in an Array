class Solution {
public:
    int maxProduct(vector<int>& nums) {
        int num1=0;
        int num2=0;
        int max=0;
        for(int i=0;i<nums.size();i++){
            if(nums[i]>num1){
                num1=nums[i];
            }
        }
        int max_count=0;
        for(int j=0;j<=nums.size()-1;j++){
            if(nums[j]==num1){
                max_count++;
            }
            if(max_count>1){
                num2=num1;
            }
            else if(nums[j]>num2 && nums[j]<num1){
                num2=nums[j];
            }
        }
        max=(num1-1)*(num2-1);
        return max;
    }
};