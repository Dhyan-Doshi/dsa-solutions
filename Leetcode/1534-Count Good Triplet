class Solution {
public:
    int countGoodTriplets(vector<int>& arr, int a, int b, int c) {
        int n=arr.size();
        int x;
        int y;
        int z;
        int ans=0;
        for(int i=0;i<n;i++){
            for(int j=i+1;j<n;j++){
                x=abs(arr[i]-arr[j]);
                for(int k=j+1;k<n;k++){
                    y=abs(arr[j]-arr[k]);
                    z=abs(arr[i]-arr[k]);
                    if(x<=a && y<=b && z<=c){
                        ans+=1;
                    }
                }
           
            }
        }
        return ans;
    }
};