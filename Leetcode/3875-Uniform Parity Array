class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
        int n=nums1.size();
        vector <int> nums2(n);
        for(int i=0;i<n;i++){
            for(int j=0;j<n;j++){
                if(i==j){
                    nums2[i]=nums1[i];
                }else{
                    nums2[i]=nums1[i]-nums1[j];
                }
            }
        }
        int z=nums2.size();
        int ans=0;
        for(int k=0;k<z;k++){
            
            if(nums2[k]%2!=0){
                ans++;
            }
            if(ans==z){
                return true;
            }
        }
        for(int k=0;k<z;k++){
            if(nums2[k]%2==0){
                ans++;
            }
            if(ans==z){
                return true;
            }
        }
        return false;
    }
};



OR ELSE OBSERVE THAT 
If nums1 has at least one odd element: 
We can subtract that odd element from any even element to make it odd
keeping all odd elements as they are. This makes every element in nums2 odd.
If nums1 has only even elements: Keep all elements as they are 
making every element in nums2 even.
