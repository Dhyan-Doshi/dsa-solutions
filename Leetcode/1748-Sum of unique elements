class Solution {
public:
    int sumOfUnique(vector<int>& nums) {
        int n=nums.size()-1;
        int freq=0;
        int sum=0;
        for(int i=0;i<=n;i++){
            for(int j=0;j<=n;j++){//Most imp
                if(i==j){
                    continue;
                }
                if(nums[i]==nums[j]){
                    freq++;
                }
            }
            if(freq==0){
                sum+=nums[i];
            }
            freq=0;
        }
        return sum;
    }
};